rules_version = '2';
// Combined rules for the Firebase project "bookshelf-9a848".
// Paste this ENTIRE file into Firebase Console → Firestore → Rules → Publish.
// The first half is the Bookshelf app's existing rules, unchanged.
// The second half adds the Family Recipe Box.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Bookshelf (unchanged) ─────────────────────────

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/books/{bookId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /emailToUid/{emailKey} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
      // Fix: a delete has no request.resource, so "allow write" above refused it
      // and Bookshelf's "Delete my account" failed. Allow deleting your own entry.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.toUid   == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.toUid   == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    // ─────────────────────────── Family Recipe Box ───────────────────────────
    // recipeBoxes/{boxId}: { name, ownerUid, members: [uid], memberNames: {uid: name},
    //                         personal, inviteCode, joinCode, createdAt }
    // Every person has one private box with id "p_<uid>" (personal: true, never shared).
    // Shared family boxes: anyone with the invite link (box id + invite code) can join after signing in.

    function rbSignedIn() { return request.auth != null; }
    function rbBox(boxId) { return get(/databases/$(database)/documents/recipeBoxes/$(boxId)).data; }
    function rbIsMember(boxId) { return rbSignedIn() && request.auth.uid in rbBox(boxId).members; }
    function rbIsOwner(boxId) { return rbSignedIn() && rbBox(boxId).ownerUid == request.auth.uid; }
    function rbIsPersonal(data) { return data.get('personal', false) == true; }

    match /recipeBoxes/{boxId} {
      // A missing box can be "read" so the app can check whether your private box exists yet.
      allow read: if rbSignedIn() && (resource == null || request.auth.uid in resource.data.members);

      allow create: if rbSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && (
          (rbIsPersonal(request.resource.data) && boxId == 'p_' + request.auth.uid)
          || (!rbIsPersonal(request.resource.data)
              && request.resource.data.inviteCode is string
              && request.resource.data.inviteCode.size() >= 16)
        );

      // The owner can rename the box, change the invite code, or remove people.
      // A private box always keeps exactly one member: its owner.
      allow update: if rbSignedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.members
        && rbIsPersonal(request.resource.data) == rbIsPersonal(resource.data)
        && (!rbIsPersonal(resource.data) || request.resource.data.members == [request.auth.uid]);

      // A member can update their own display name.
      allow update: if rbSignedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberNames'])
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);

      // Joining: add only yourself, and only with the right invite code.
      allow update: if rbSignedIn()
        && !rbIsPersonal(resource.data)
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode'])
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);

      // Leaving: a member (not the owner) can remove only themselves.
      allow update: if rbSignedIn() && request.auth.uid in resource.data.members
        && resource.data.ownerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        && !(request.auth.uid in request.resource.data.members)
        && resource.data.members.removeAll(request.resource.data.members).hasOnly([request.auth.uid]);

      allow delete: if rbSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /recipes/{recipeId} {
        allow read: if rbIsMember(boxId);
        allow create: if rbIsMember(boxId) && request.resource.data.addedBy == request.auth.uid;
        allow update: if rbIsMember(boxId) && request.resource.data.addedBy == resource.data.addedBy;
        allow delete: if rbIsMember(boxId) && (resource.data.addedBy == request.auth.uid || rbIsOwner(boxId));
      }

      match /memories/{memoryId} {
        allow read: if rbIsMember(boxId);
        allow create: if rbIsMember(boxId) && request.resource.data.by == request.auth.uid;
        allow update: if false;
        allow delete: if rbIsMember(boxId) && (resource.data.by == request.auth.uid || rbIsOwner(boxId));
      }

      // Photos of the original cards, stored as compressed JPEG data URLs (< 1 MB each).
      match /photos/{photoId} {
        allow read: if rbIsMember(boxId);
        allow create: if rbIsMember(boxId) && request.resource.data.by == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow update: if false;
        allow delete: if rbIsMember(boxId) && (resource.data.by == request.auth.uid || rbIsOwner(boxId));
      }

      // Activity feed for notifications: someone joined, added recipes, or shared a memory.
      // Written by the person who did it, as themselves, stamped with the server's time.
      match /activity/{activityId} {
        allow read: if rbIsMember(boxId);
        allow create: if rbIsMember(boxId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.type in ['join', 'recipe', 'memory']
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['type', 'by', 'byName', 'createdAt', 'recipeIds', 'titles', 'count', 'recipeId', 'title', 'text', 'recipeBy']);
        allow update: if false;
        allow delete: if rbIsMember(boxId) && (resource.data.by == request.auth.uid || rbIsOwner(boxId));
      }

      // Who's here now: one small record per person, refreshed while the app is open.
      match /presence/{uid} {
        allow read: if rbIsMember(boxId);
        allow create, update: if rbIsMember(boxId) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'at', 'here'])
          && request.resource.data.at == request.time;
        allow delete: if rbSignedIn() && (uid == request.auth.uid || rbIsOwner(boxId));
      }
    }

    // Each person's own Recipe Box settings (notifications, theme). Nobody else can read them.
    match /recipeUsers/{uid} {
      allow read, write: if rbSignedIn() && request.auth.uid == uid;
    }
  }
}
