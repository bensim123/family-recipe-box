rules_version = '2';
// Combined rules for the Firebase project "bookshelf-9a848".
// Paste this ENTIRE file into Firebase Console → Firestore → Rules → Publish.
// The first half is the Bookshelf app's existing rules, unchanged.
// The second half adds the Family Recipe Box.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Bookshelf (unchanged) ─────────────────────────

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/books/{bookId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /emailToUid/{emailKey} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.toUid   == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.toUid   == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    // ─────────────────────────── Family Recipe Box ───────────────────────────
    // recipeBoxes/{boxId}: { name, ownerUid, members: [uid], memberNames: {uid: name},
    //                         personal, inviteCode, joinCode, createdAt }
    // Every person has one private box with id "p_<uid>" (personal: true, never shared).
    // Shared family boxes: anyone with the invite link (box id + invite code) can join after signing in.

    function signedIn() { return request.auth != null; }
    function box(boxId) { return get(/databases/$(database)/documents/recipeBoxes/$(boxId)).data; }
    function isMember(boxId) { return signedIn() && request.auth.uid in box(boxId).members; }
    function isOwner(boxId) { return signedIn() && box(boxId).ownerUid == request.auth.uid; }
    function isPersonalBox(data) { return data.get('personal', false) == true; }

    match /recipeBoxes/{boxId} {
      // A missing box can be "read" so the app can check whether your private box exists yet.
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && (
          (isPersonalBox(request.resource.data) && boxId == 'p_' + request.auth.uid)
          || (!isPersonalBox(request.resource.data)
              && request.resource.data.inviteCode is string
              && request.resource.data.inviteCode.size() >= 16)
        );

      // The owner can rename the box, change the invite code, or remove people.
      // A private box always keeps exactly one member: its owner.
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.members
        && isPersonalBox(request.resource.data) == isPersonalBox(resource.data)
        && (!isPersonalBox(resource.data) || request.resource.data.members == [request.auth.uid]);

      // A member can update their own display name.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberNames'])
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);

      // Joining: add only yourself, and only with the right invite code.
      allow update: if signedIn()
        && !isPersonalBox(resource.data)
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode'])
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);

      // Leaving: a member (not the owner) can remove only themselves.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && resource.data.ownerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        && !(request.auth.uid in request.resource.data.members)
        && resource.data.members.removeAll(request.resource.data.members).hasOnly([request.auth.uid]);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /recipes/{recipeId} {
        allow read: if isMember(boxId);
        allow create: if isMember(boxId) && request.resource.data.addedBy == request.auth.uid;
        allow update: if isMember(boxId) && request.resource.data.addedBy == resource.data.addedBy;
        allow delete: if isMember(boxId) && (resource.data.addedBy == request.auth.uid || isOwner(boxId));
      }

      match /memories/{memoryId} {
        allow read: if isMember(boxId);
        allow create: if isMember(boxId) && request.resource.data.by == request.auth.uid;
        allow update: if false;
        allow delete: if isMember(boxId) && (resource.data.by == request.auth.uid || isOwner(boxId));
      }

      // Photos of the original cards, stored as compressed JPEG data URLs (< 1 MB each).
      match /photos/{photoId} {
        allow read: if isMember(boxId);
        allow create: if isMember(boxId) && request.resource.data.by == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow update: if false;
        allow delete: if isMember(boxId) && (resource.data.by == request.auth.uid || isOwner(boxId));
      }
    }
  }
}
